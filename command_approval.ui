<ui version="4.0"><class>CommandApproval</class><widget class="QDialog" name="CommandApproval"><property name="windowTitle"><string>确认电脑操作</string></property><property name="geometry"><rect><x>0</x><y>0</y><width>700</width><height>440</height></rect></property><layout class="QVBoxLayout" name="mainLayout">
<item><widget class="QLabel" name="introLabel"><property name="text"><string>AI 请求执行以下命令。执行后可能修改文件或启动程序；仅在确认内容符合你的要求时执行。</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
